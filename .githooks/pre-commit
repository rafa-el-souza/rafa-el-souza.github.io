#!/bin/sh
# Runs before every commit once a clone has `git config core.hooksPath .githooks`.
# It scans the staged changes for secrets and refuses a commit it cannot scan;
# CI scans the whole history again. When a workflow is staged it also lints the
# workflows, which CI does not do.
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so the staged changes cannot be scanned for secrets." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --verbose

if git diff --cached --name-only --diff-filter=ACMR -- .github/workflows | grep -q .; then
  if ! command -v actionlint >/dev/null 2>&1; then
    echo "pre-commit: a workflow is staged, and actionlint is not installed to lint it." >&2
    exit 1
  fi
  actionlint
fi
